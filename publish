#!/bin/bash
set -eu
cd "$(dirname "$0")"
if [ "$(git branch --show-current)" != main ]; then
  echo "Publish from the main branch of the website checkout." >&2
  exit 1
fi
python3 build.py
git add -A -- essays notebook writing notes garden about connections index.html assets layout build.py publish README.md .gitignore
if ! git diff --cached --quiet; then
  git commit -m "${1:-Update the mango notebook}"
fi
git push origin main
echo "Pushed to GitHub Pages. Deployment status: https://github.com/saanvimehra/saanvimehra.github.io/actions"
